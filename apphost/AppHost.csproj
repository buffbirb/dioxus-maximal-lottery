<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- dotnet run uses the Aspire CLI released with Aspire.Hosting.AppHost, so
         that one version pins the CLI, DCP and the dashboard. -->
    <AspireCliInvocationMode>DnxPinned</AspireCliInvocationMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>dioxus-maximal-lottery-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

</Project>
